<!DOCTYPE html><html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"><link rel="stylesheet" type="text/css" href="cid:css-618d9c7e-56d7-42b1-a8bb-0ae042d086dd@mhtml.blink" />
    
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🎬 Viral Short Video Generator - Fully Functional</title>
    
</head>
<body>
    <div class="container">
        <header>
            <h1>🎬 Viral Short Video Generator</h1>
            <p class="subtitle">Create engaging short videos with real AI voiceovers - Now with VIDEO ENCODING!</p>
        </header>

        <div class="main-content">
            <!-- Left Panel: Media Upload -->
            <div class="panel">
                <h2>📸 Upload Media</h2>
                <div class="upload-area" id="mediaUploadArea">
                    <div class="upload-icon">📁</div>
                    <h3>Drag &amp; Drop Image/GIF</h3>
                    <p>or click to browse (JPG, PNG, GIF, WebP)</p>
                    <input type="file" id="mediaFile" class="file-input" accept="image/*,.gif">
                </div>

                <div class="preview-container">
                    <img id="mediaPreview" alt="Media Preview">
                </div>

                <div class="api-status">
                    <h4>📊 Media Status</h4>
                    <div class="progress-bar">
                        <div class="progress-fill" id="mediaProgress" style="width: 0%;"></div>
                    </div>
                    <p id="mediaStatus">Ready for media upload</p>
                </div>
            </div>

            <!-- Right Panel: Script & Voice Controls -->
            <div class="panel">
                <h2>📝 Script &amp; Voice</h2>
                
                <div class="upload-area" id="scriptUploadArea">
                    <div class="upload-icon">📄</div>
                    <h3>Upload Script File</h3>
                    <p>or click to browse (TXT, MD)</p>
                    <input type="file" id="scriptFile" class="file-input" accept=".txt,.md">
                </div>

                <textarea id="scriptInput" class="script-input" placeholder="Type or paste your script here...

Example viral script:
Want to go viral? Here's the secret: Hook viewers in 3 seconds, deliver value fast, and end with a strong call to action. Let's make your content unstoppable!"></textarea>

                <div class="voice-controls">
                    <h3>🎤 Voice Settings</h3>
                    <select id="voiceSelect" class="voice-select">
                        <option value="en-US-JennyNeural">Jenny (US English - Female)</option>
                        <option value="en-US-GuyNeural">Guy (US English - Male)</option>
                        <option value="en-US-AriaNeural">Aria (US English - Female)</option>
                        <option value="en-US-DavisNeural">Davis (US English - Male)</option>
                        <option value="en-GB-SoniaNeural">Sonia (British English - Female)</option>
                        <option value="en-GB-RyanNeural">Ryan (British English - Male)</option>
                    </select>

                    <div class="slider-container">
                        <label for="rateSlider">Speech Rate: <span id="rateValue">+0%</span></label>
                        <input type="range" id="rateSlider" min="-50" max="50" step="10" value="0">
                    </div>

                    <div class="slider-container">
                        <label for="pitchSlider">Pitch: <span id="pitchValue">+0Hz</span></label>
                        <input type="range" id="pitchSlider" min="-100" max="100" step="20" value="0">
                    </div>

                    <div class="api-status">
                        <h4>🔊 TTS API Status</h4>
                        <div class="progress-bar">
                            <div class="progress-fill" id="ttsProgress" style="width: 0%;"></div>
                        </div>
                        <p id="ttsStatus">FreeTTS API ready</p>
                    </div>
                </div>

                <div class="controls">
                    <button id="previewBtn" class="btn-primary">
                        <span class="icon">▶️</span> Preview Voice
                    </button>
                    <button id="generateBtn" class="btn-primary">
                        <span class="icon">🎬</span> Generate Video
                    </button>
                    <button id="debugBtn" class="btn-secondary debug-toggle">
                        <span class="icon">🐛</span> Debug
                    </button>
                </div>

                <div class="loading" id="loading">
                    <div class="spinner"></div>
                    <p id="loadingText">Processing your video...</p>
                </div>

                <div id="status" class="status"></div>

                <div class="debug-panel" id="debugPanel">
                    <h4>Debug Information</h4>
                    <div id="debugLog"></div>
                </div>
            </div>
        </div>

        <!-- Video Output Section -->
        <div class="panel" style="grid-column: 1 / -1; margin: 0 30px 30px;">
            <h2>🎥 Video Output</h2>
            
            <div class="encoding-status" id="encodingStatus" style="display: none;">
                <h4>🎞️ Video Encoding Progress</h4>
                <div class="encoding-progress">
                    <div class="encoding-progress-fill" id="encodingProgress"></div>
                </div>
                <p id="encodingStatusText">Preparing video encoding...</p>
            </div>
            
            <div class="audio-player" id="audioPlayerContainer" style="display: none;">
                <h3>🎵 Generated Audio</h3>
                <audio id="generatedAudio" controls="" style="width: 100%;"></audio>
                <button id="downloadAudioBtn" class="btn-secondary" style="margin-top: 10px;">
                    <span class="icon">⬇️</span> Download Audio (MP3)
                </button>
            </div>

            <div class="video-output">
                <canvas id="videoCanvas" width="1080" height="1920"></canvas>
                
                <div class="video-player" id="videoPlayerContainer">
                    <h3>🎬 Generated Video</h3>
                    <video id="generatedVideo" controls="" style="width: 100%;"></video>
                </div>
                
                <div class="controls" style="justify-content: center; margin-top: 20px;">
                    <button id="downloadVideoBtn" class="btn-primary download-btn">
                        <span class="icon">⬇️</span> Download Video (MP4)
                    </button>
                    <button id="downloadImageBtn" class="btn-secondary download-btn">
                        <span class="icon">🖼️</span> Download Image Only
                    </button>
                </div>
            </div>

            <div class="instructions">
                <h3>🚀 How to Use This Generator:</h3>
                <ul>
                    <li><strong>Step 1:</strong> Upload an image or GIF (vertical works best for TikTok/Reels)</li>
                    <li><strong>Step 2:</strong> Write or upload your script (keep it under 60 seconds)</li>
                    <li><strong>Step 3:</strong> Select voice and adjust settings</li>
                    <li><strong>Step 4:</strong> Click "Generate Video" - audio will be created via FreeTTS API</li>
                    <li><strong>Step 5:</strong> Video will be automatically encoded with audio embedded</li>
                    <li><strong>Step 6:</strong> Download the complete MP4 video ready for social media!</li>
                </ul>
                
                <h3 style="margin-top: 20px;">💡 Pro Tips for Viral Content:</h3>
                <ul>
                    <li>Use <strong>bold text overlays</strong> for silent viewers</li>
                    <li>Keep videos <strong>under 60 seconds</strong> for maximum engagement</li>
                    <li>Start with a <strong>hook question</strong> to grab attention</li>
                    <li>Use <strong>trending audio styles</strong> - this tool creates custom trending voiceovers</li>
                    <li>Add <strong>subtitles/captions</strong> for accessibility and silent viewing</li>
                </ul>
            </div>
        </div>

        <footer>
            <p>Viral Short Video Generator v3.0 | Now with VIDEO ENCODING!</p>
            <p>Uses FreeTTS API (400+ voices, 75+ languages) &amp; MediaRecorder API</p>
            <p>No API key required | Rate limit: 20 requests per minute</p>
            <p>Created with ❤️ for content creators | Works in all modern browsers</p>
        </footer>
    </div>

    

</body></html>
