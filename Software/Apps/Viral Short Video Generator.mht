@charset "utf-8";

* { margin: 0px; padding: 0px; box-sizing: border-box; font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif; }

body { background: linear-gradient(135deg, rgb(102, 126, 234) 0%, rgb(118, 75, 162) 100%); min-height: 100vh; padding: 20px; color: rgb(51, 51, 51); }

.container { max-width: 1200px; margin: 0px auto; background: white; border-radius: 20px; box-shadow: rgba(0, 0, 0, 0.3) 0px 20px 60px; overflow: hidden; }

header { background: linear-gradient(135deg, rgb(240, 147, 251) 0%, rgb(245, 87, 108) 100%); color: white; padding: 30px; text-align: center; }

h1 { font-size: 2.8rem; margin-bottom: 10px; text-shadow: rgba(0, 0, 0, 0.2) 2px 2px 4px; }

.subtitle { font-size: 1.2rem; opacity: 0.9; margin-bottom: 20px; }

.main-content { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; padding: 30px; }

@media (max-width: 768px) {
  .main-content { grid-template-columns: 1fr; }
}

.panel { background: rgb(248, 249, 250); border-radius: 15px; padding: 25px; box-shadow: rgba(0, 0, 0, 0.1) 0px 5px 15px; }

h2 { color: rgb(108, 99, 255); margin-bottom: 20px; padding-bottom: 10px; border-bottom: 2px solid rgb(224, 224, 224); }

.upload-area { border: 3px dashed rgb(108, 99, 255); border-radius: 10px; padding: 40px 20px; text-align: center; margin-bottom: 20px; cursor: pointer; transition: 0.3s; background: rgb(240, 242, 255); }

.upload-area:hover { background: rgb(230, 233, 255); transform: translateY(-2px); }

.upload-area.dragover { background: rgb(217, 220, 255); border-color: rgb(74, 68, 200); }

.upload-icon { font-size: 48px; color: rgb(108, 99, 255); margin-bottom: 15px; }

.file-input { display: none; }

.preview-container { margin-top: 20px; text-align: center; }

#mediaPreview { max-width: 100%; max-height: 300px; border-radius: 10px; box-shadow: rgba(0, 0, 0, 0.2) 0px 5px 15px; display: none; }

.script-input { width: 100%; height: 200px; padding: 15px; border: 2px solid rgb(221, 221, 221); border-radius: 10px; font-size: 16px; resize: vertical; margin-bottom: 20px; font-family: "Courier New", monospace; }

.script-input:focus { outline: none; border-color: rgb(108, 99, 255); }

.controls { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 20px; }

button { padding: 12px 24px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; transition: 0.3s; display: flex; align-items: center; gap: 8px; }

.btn-primary { background: linear-gradient(135deg, rgb(108, 99, 255) 0%, rgb(74, 68, 200) 100%); color: white; }

.btn-primary:hover:not(:disabled) { transform: translateY(-2px); box-shadow: rgba(108, 99, 255, 0.4) 0px 5px 15px; }

.btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }

.btn-secondary { background: rgb(240, 242, 255); color: rgb(108, 99, 255); border: 2px solid rgb(108, 99, 255); }

.btn-secondary:hover:not(:disabled) { background: rgb(108, 99, 255); color: white; }

.btn-secondary:disabled { opacity: 0.6; cursor: not-allowed; }

.btn-danger { background: linear-gradient(135deg, rgb(255, 107, 107) 0%, rgb(238, 90, 82) 100%); color: white; }

.btn-danger:hover:not(:disabled) { transform: translateY(-2px); box-shadow: rgba(255, 107, 107, 0.4) 0px 5px 15px; }

.voice-controls { background: white; padding: 20px; border-radius: 10px; margin-top: 20px; border: 2px solid rgb(224, 224, 224); }

.voice-select { width: 100%; padding: 10px; border: 2px solid rgb(221, 221, 221); border-radius: 8px; font-size: 16px; margin-bottom: 15px; }

.slider-container { margin: 15px 0px; }

label { display: block; margin-bottom: 8px; font-weight: 600; color: rgb(85, 85, 85); }

input[type="range"] { width: 100%; height: 8px; border-radius: 4px; background: rgb(221, 221, 221); outline: none; }

.status { padding: 15px; border-radius: 10px; margin: 20px 0px; display: none; font-weight: 600; }

.status.success { background: rgb(212, 237, 218); color: rgb(21, 87, 36); border: 1px solid rgb(195, 230, 203); }

.status.error { background: rgb(248, 215, 218); color: rgb(114, 28, 36); border: 1px solid rgb(245, 198, 203); }

.status.info { background: rgb(209, 236, 241); color: rgb(12, 84, 96); border: 1px solid rgb(190, 229, 235); }

.status.warning { background: rgb(255, 243, 205); color: rgb(133, 100, 4); border: 1px solid rgb(255, 234, 167); }

.video-output { text-align: center; margin-top: 30px; }

#videoCanvas { max-width: 100%; border-radius: 15px; box-shadow: rgba(0, 0, 0, 0.3) 0px 10px 30px; background: rgb(0, 0, 0); display: none; }

.download-btn { margin: 20px auto; padding: 15px 30px; font-size: 18px; display: none; }

.instructions { background: rgb(232, 244, 252); padding: 20px; border-radius: 10px; margin-top: 30px; border-left: 5px solid rgb(108, 99, 255); }

.instructions h3 { color: rgb(108, 99, 255); margin-bottom: 15px; }

.instructions ul { padding-left: 20px; }

.instructions li { margin-bottom: 10px; line-height: 1.6; }

footer { text-align: center; padding: 20px; color: rgb(102, 102, 102); font-size: 0.9rem; border-top: 1px solid rgb(238, 238, 238); margin-top: 30px; }

.loading { display: none; text-align: center; margin: 20px 0px; }

.spinner { border-width: 4px; border-style: solid; border-color: rgb(108, 99, 255) rgb(243, 243, 243) rgb(243, 243, 243); border-image: initial; border-radius: 50%; width: 40px; height: 40px; animation: 1s linear 0s infinite normal none running spin; margin: 0px auto 10px; }

@keyframes spin { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.icon { font-size: 20px; }

.api-status { background: rgb(248, 249, 250); padding: 15px; border-radius: 10px; margin: 15px 0px; border: 2px solid rgb(224, 224, 224); }

.api-status h4 { color: rgb(108, 99, 255); margin-bottom: 10px; }

.progress-bar { width: 100%; height: 20px; background: rgb(224, 224, 224); border-radius: 10px; overflow: hidden; margin: 10px 0px; }

.progress-fill { height: 100%; background: linear-gradient(90deg, rgb(108, 99, 255), rgb(74, 68, 200)); width: 0%; transition: width 0.3s; }

.audio-player { width: 100%; margin: 20px 0px; }

.debug-panel { background: rgb(45, 55, 72); color: white; padding: 15px; border-radius: 10px; margin-top: 20px; font-family: monospace; font-size: 12px; max-height: 200px; overflow-y: auto; display: none; }

.debug-toggle { background: rgb(74, 85, 104); color: white; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 8px 16px; border-radius: 5px; cursor: pointer; margin-top: 10px; }

.video-player { width: 100%; margin: 20px 0px; display: none; }

.video-player video { width: 100%; border-radius: 15px; box-shadow: rgba(0, 0, 0, 0.3) 0px 10px 30px; background: rgb(0, 0, 0); }

.encoding-status { background: rgb(232, 244, 252); padding: 15px; border-radius: 10px; margin: 15px 0px; border-left: 5px solid rgb(108, 99, 255); }

.encoding-status h4 { color: rgb(108, 99, 255); margin-bottom: 10px; }

.encoding-progress { width: 100%; height: 20px; background: rgb(224, 224, 224); border-radius: 10px; overflow: hidden; margin: 10px 0px; }

.encoding-progress-fill { height: 100%; background: linear-gradient(90deg, rgb(240, 147, 251), rgb(245, 87, 108)); width: 0%; transition: width 0.3s; }
