        /* JSON syntax highlighting */
        .json-key { color: #d73a49; }
        .json-string { color: #032f62; }
        .json-number { color: #005cc5; }
        .json-boolean { color: #6f42c1; }
        .json-null { color: #6a737d; }

        body.dark-mode .json-key { color: #ff7b72; }
        body.dark-mode .json-string { color: #a5d6ff; }
        body.dark-mode .json-number { color: #79c0ff; }
        body.dark-mode .json-boolean { color: #d2a8ff; }
