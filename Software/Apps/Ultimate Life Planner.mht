@charset "utf-8";

* { margin: 0px; padding: 0px; box-sizing: border-box; }

body { font-family: Arial, sans-serif; padding: 20px; background: rgb(240, 242, 245); }

.container { max-width: 1000px; margin: 0px auto; background: white; padding: 20px; border-radius: 10px; box-shadow: rgba(0, 0, 0, 0.1) 0px 2px 10px; }

h1 { text-align: center; color: rgb(44, 62, 80); margin-bottom: 20px; }

.tabs { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 20px; }

.tab { padding: 10px 20px; background: rgb(52, 152, 219); color: white; border-radius: 5px; cursor: pointer; }

.tab.active { background: rgb(41, 128, 185); }

.section { display: none; padding: 20px; border: 1px solid rgb(221, 221, 221); border-radius: 5px; }

.section.visible { display: block; }

input, textarea, select, button { width: 100%; padding: 10px; margin: 10px 0px; border: 1px solid rgb(221, 221, 221); border-radius: 5px; }

button { background: rgb(46, 204, 113); color: white; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; cursor: pointer; }

button:hover { background: rgb(39, 174, 96); }

.list { margin-top: 20px; }

.list-item { background: rgb(248, 249, 250); padding: 10px; margin: 5px 0px; border-radius: 5px; display: flex; justify-content: space-between; }

.delete-btn { background: rgb(231, 76, 60); color: white; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; padding: 5px 10px; border-radius: 3px; cursor: pointer; }
