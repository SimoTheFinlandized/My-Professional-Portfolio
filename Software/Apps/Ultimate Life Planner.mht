<!DOCTYPE html><html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"><link rel="stylesheet" type="text/css" href="cid:css-67a8b420-84dc-4d2b-83bb-b3fcf8e9b2d3@mhtml.blink" />
    
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ultimate Life Planner - Fixed Version</title>
    
</head>
<body>
    <div class="container">
        <h1>Ultimate Life Planner 🚀</h1>

        <div class="tabs">
            <div class="tab active" data-section="tasks">Tasks</div>
            <div class="tab" data-section="calendar">Calendar</div>
            <div class="tab" data-section="journal">Journal</div>
            <div class="tab" data-section="habit">Habits</div>
        </div>

        <!-- Task Manager -->
        <div id="tasks" class="section visible">
            <h2>Task Manager</h2>
            <input type="text" id="task-input" placeholder="Enter task">
            <button>Add Task</button>
            <div id="task-list" class="list"></div>
        </div>

        <!-- Calendar -->
        <div id="calendar" class="section">
            <h2>Calendar</h2>
            <input type="date" id="calendar-date">
            <input type="text" id="calendar-event" placeholder="Event description">
            <button>Save Event</button>
            <div id="calendar-list" class="list"></div>
        </div>

        <!-- Journal -->
        <div id="journal" class="section">
            <h2>Journal</h2>
            <textarea id="journal-entry" rows="4" placeholder="Write your thoughts..."></textarea>
            <button>Save Entry</button>
            <div id="journal-entries" class="list"></div>
        </div>

        <!-- Habit Tracker -->
        <div id="habit" class="section">
            <h2>Habit Tracker</h2>
            <input type="text" id="habit-input" placeholder="Enter habit">
            <button>Add Habit</button>
            <div id="habit-list" class="list"></div>
        </div>
    </div>

    

</body></html>
